msgstr ""
"Din systeminformation har kopierats till ditt urklipp så att du kan klistra "
"in den på forumet."

#: usr/lib/linuxmint/mintreport/app.py:526
msgid "System information uploaded"
msgstr "Systeminformation uppladdad"

#: usr/lib/linuxmint/mintreport/app.py:526
#, python-format
msgid ""
